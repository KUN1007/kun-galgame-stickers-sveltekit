{
  "name": "kun-galgame-stickers",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "node scripts/dev-preflight.mjs && pnpm -F \"./apps/**\" --parallel --stream run dev",
    "dev:web": "node scripts/dev-preflight.mjs web && pnpm -F web run dev",
    "dev:api": "node scripts/dev-preflight.mjs api && pnpm -F @apps/api run dev",
    "dev:ports": "node scripts/dev-preflight.mjs",
    "build": "pnpm run build:api && pnpm run build:web",
    "build:web": "pnpm -F web run build",
    "build:api": "pnpm -F @apps/api run build",
    "lint": "pnpm -F web run lint",
    "typecheck": "pnpm -F web run typecheck",
    "vet": "pnpm -F @apps/api run vet",
    "migrate": "pnpm -F @apps/api run migrate"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
